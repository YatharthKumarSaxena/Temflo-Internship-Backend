# ------------------  Server Config ---------------
NODE_ENV=development
PORT=8888
FRONTEND_URL="https://erpica.in"
# FRONTEND_URL="https://erpica.netlify.app/"
BACKEND_URL="https://erpica.in"
OPENSSL_CONF='/dev/null'
PUBLIC_SERVER_FILE="https://erpica.in/"

# ------------------  Database -----------------------
# Replace with your MongoDB connection string (do NOT commit real credentials)
DATABASE="mongodb+srv://<DB_USER>:<DB_PASS>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority"

# ------------------  Third-party / API Keys -----------------------
RESEND_API="REPLACE_WITH_YOUR_RESEND_API_KEY"

# ------------------  Email Services --------------
SMTP_EMAIL=your-email@example.com
SMTP_PASS=your-smtp-password-or-app-password

# ------------------  Cloudinary ------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ------------------  JWT Authentication ----------
JWT_SECRET=replace_with_jwt_secret
JWT_REFRESH_SECRET=replace_with_jwt_refresh_secret
JWT_ACCESS_TOKEN_EXPIRY=1d
JWT_REFRESH_TOKEN_EXPIRY=7d

# ------------------  Security Config --------------
BCRYPT_SALT_ROUNDS=12

# ------------------  Token Expiry -----------------
EMAIL_TOKEN_EXPIRY=300000        # in milliseconds (example: 5 minutes)
RESET_TOKEN_EXPIRY=1800000       # in milliseconds (example: 30 minutes)

# ------------------  Rate Limiting ---------------
# General API rate limiting
RATE_LIMIT_WINDOW=1              # in minutes
RATE_LIMIT_MAX=200

# ------------------  CORS Configuration ----------
# Comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://erpica.in
CORS_CREDENTIALS=true

# ------------------  Messaging / Queue -----------------
# Options for ACTIVITY_METHOD: async | rabbitmq | kafka
ACTIVITY_METHOD=async
RABBITMQ_URL=amqp://localhost
KAFKA_BROKER=localhost:9092

# ------------------  Notes -------------------------
# 1. Do NOT commit the real .env with secrets to version control.
# 2. Use environment-specific .env files (e.g., .env.development, .env.production).
# 3. For production, prefer secret managers (Vault, AWS Secrets Manager, GCP Secret Manager, etc.).
